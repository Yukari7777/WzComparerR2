{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: WzComparerR2 alt output",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "WzComparerR2\\WzComparerR2.csproj",
        "-p:TargetFramework=net8.0-windows",
        "-o",
        ".test-build\\WzComparerR2"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [
        "$msCompile"
      ]
    }
  ]
}
